# Copy to deploy.env and fill in. deploy.env is gitignored — it holds your
# server address, not secrets that belong in the app.
#
#   cp deploymentScript/deploy.env.example deploymentScript/deploy.env

# Where to ship the build. Anything ssh understands.
SSH_TARGET="root@your-server-ip"

# Absolute path to the checked-out repo ON THE SERVER — the directory that
# holds package.json and the live .next.
REMOTE_DIR="/var/www/html/QR_SAAS"

# Optional: ssh port, if not 22.
# SSH_PORT="22"

# Optional: PM2 process name, if you renamed it. Default "qrveda".
# APP_NAME="qrveda"

# Optional: the port the app listens on. Default 3003. Only used when PM2 has
# no existing process and the script has to start one from scratch.
# APP_PORT="3003"

# Optional: public URL used for the post-deploy smoke test, which asks for a
# short code that cannot exist and expects a 404 from the redirect route.
# Default https://qrveda.com.
# HEALTH_URL="https://qrveda.com"

# Optional: set to 1 to deploy code WITHOUT running `npm run db:migrate`.
# Rarely the right call — only when a migration is known-bad and you are rolling
# the code forward regardless.
# SKIP_MIGRATE="0"
