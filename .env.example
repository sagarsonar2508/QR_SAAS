# Copy to .env and fill in. Leave the payment keys empty to run in free pilot
# mode — no plan limits are enforced and no money is ever charged.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/qrveda
APP_URL=http://localhost:3003
SESSION_SECRET=generate-a-long-random-string

# Google OAuth (leave empty to hide the Google login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Email (nodemailer over SMTP). Used for signup verification, password reset and
# password-change notices. With these unset the app still runs — messages are
# logged instead of sent, and the UI says so rather than pretending they went.
#
# Gmail: use an App Password (not your account password) with
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you@gmail.com
# Deliverability is much better from a real sending service once you have users.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER. Use a name + address the recipient will recognise.
SMTP_FROM=
# Leave unset to infer from the port (465 = implicit TLS, otherwise STARTTLS).
SMTP_SECURE=

# Admin panel (/admin). Comma-separated emails that always have access, even if
# their users.role isn't 'admin'. This is the bootstrap + recovery path — set at
# least one, or access depends entirely on a database column.
ADMIN_EMAILS=

# Optional: override the FX rates the admin panel uses to normalise revenue to
# INR. JSON, rate = INR per 1 unit. Unlisted currencies keep the built-in
# estimates. e.g. {"USD":88.5,"EUR":95.2,"GBP":112}
FX_RATES_INR=

# ---------------------------------------------------------------------------
# Payments. Two providers, split by the customer's currency:
#   Razorpay -> INR (India). Keeps UPI Autopay, settles to an Indian bank.
#              Cannot hold a recurring mandate in any other currency, so
#              "Razorpay international" does NOT cover the rest of the world.
#   PayPal   -> USD (everywhere else). Real recurring billing via PayPal
#              Subscriptions.
# Configure either, both, or neither. See docs/BILLING.md.
#
# NOTE: neither is a merchant of record, so EU/UK VAT on USD sales is our
# liability, not the provider's. A Paddle adapter that would have handled it was
# written and never enabled; it was deleted on 10 Sep 2026.
# ---------------------------------------------------------------------------

# Razorpay — webhook endpoint: <APP_URL>/api/billing/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Tags subscriptions this app creates. Razorpay webhooks are scoped by event
# type, not by website — if you run several products on one Razorpay account,
# every endpoint receives all subscription events. This tag is how each app
# recognises its own; make it unique per product.
# THIS ACCOUNT IS SHARED with daredate.in and cheekydeck.com, so the tag is
# load-bearing, not a precaution.
RAZORPAY_APP_TAG=qrveda

# PayPal — webhook endpoint: <APP_URL>/api/billing/webhook/paypal
# PAYPAL_ENV must be "live" to hit production; anything else uses sandbox, so a
# missing value can never accidentally charge a real card.
# Use a PayPal REST app of QRVeda's OWN — do not reuse the daredate.in or
# cheekydeck.com credentials. PAYPAL_WEBHOOK_ID comes from that app's Webhooks
# section and is not a secret; without it every delivery is rejected unverified.
# Subscribe the webhook to: BILLING.SUBSCRIPTION.ACTIVATED, .CANCELLED,
# .SUSPENDED, .EXPIRED, .UPDATED and PAYMENT.SALE.COMPLETED.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
