# Copy to .env and fill in. Leave the payment keys empty to run in free pilot
# mode — no plan limits are enforced and no money is ever charged.

DATABASE_URL=postgres://postgres:postgres@localhost:5433/qrveda
APP_URL=http://localhost:3003
SESSION_SECRET=generate-a-long-random-string

# Google OAuth (leave empty to hide the Google login button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: path to MaxMind GeoLite2-City.mmdb for city/country analytics
GEOIP_DB_PATH=

# ---------------------------------------------------------------------------
# Payments. Two providers, split by the customer's currency:
#   Razorpay -> INR (India). Keeps UPI Autopay, settles to an Indian bank.
#   Paddle   -> USD/EUR/GBP/AUD/CAD (rest of world). Merchant of record, so
#               Paddle registers and remits VAT/sales tax on our behalf.
# Configure either, both, or neither. See docs/BILLING.md.
# ---------------------------------------------------------------------------

# Razorpay — webhook endpoint: <APP_URL>/api/billing/webhook/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Paddle — webhook endpoint: <APP_URL>/api/billing/webhook/paddle
# PADDLE_ENV must be "live" to hit production; anything else uses sandbox, so a
# missing value can never accidentally charge a real card.
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
